@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component Diagram for Backend API (F.L.A.S.H. System)

' External Containers & Clients
Container(web_app, "Web Application", "HTML, CSS, JS / React", "Used by Faculty, Director, & Admin for dashboard access & session management")
Container(mobile_web, "Mobile & Web Client", "PWA / Web", "Used by Students to select active classes & check-in via QR/ID")
ContainerDb(database, "Database", "Relational DB", "Stores attendance records, session logs, & archived term data")

' External Systems
System_Ext(ai_engine, "AI Engine", "Processes attendance trends & generates class summaries")
System_Ext(entra, "Microsoft Entra ID", "Handles OAuth 2.0 Auth, RBAC & Executive Permissions")

' Component Boundary
Container_Boundary(backend_api, "Backend API / Application Server") {

    Component(attendance_comp, "Attendance Module", "Business Logic", "Processes QR/ID check-ins, evaluates APC geofence (Onsite vs. Online tagging), and updates live rosters.")
    Component(reports_comp, "Reports & Analytics Module", "Business Logic", "Compiles attendance logs, interfaces with AI Engine for class summaries & trend analysis, and exports PDF reports.")
    Component(admin_comp, "Admin & Security Module", "Business Logic", "Enforces Entra ID SSO authentication, RBAC permissions, domain routing, and term archiving.")
}

' Interactions - Clients to API Modules
Rel(mobile_web, attendance_comp, "Submits QR/ID scan & device GPS coordinates", "HTTPS / JSON")
Rel(web_app, attendance_comp, "Initializes dynamic QR sessions & manages live rosters", "HTTPS / JSON")
Rel(web_app, reports_comp, "Requests class AI summaries, trend analytics, & PDF exports", "HTTPS / JSON")
Rel(web_app, admin_comp, "Authenticates users, manages RBAC, & triggers term archives", "HTTPS / JSON")

' Interactions - API Modules to Database & External Systems
Rel(attendance_comp, database, "Writes attendance records & status tags (Onsite/Online)", "SQL")
Rel(reports_comp, ai_engine, "Sends aggregated attendance logs for AI analysis & summary generation", "REST API / HTTPS")
Rel(reports_comp, database, "Reads historical attendance data for reports & trends", "SQL")
Rel(admin_comp, entra, "Validates SSO tokens & user roles", "OAuth 2.0 / OIDC")
Rel(admin_comp, database, "Archives term records, system logs, & RBAC configurations", "SQL")

@enduml
raw.githubusercontent.com
