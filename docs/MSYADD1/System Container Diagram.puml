@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram for F.L.A.S.H. System

' Actors & External Systems
Person(student, "SHS Student", "Logs and checks class attendance records.")
Person(faculty, "SHS Faculty", "Manages class attendance records and views attendance reports.")
Person(director, "SHS Director", "Monitors class attendance, views attendance reports, and tracks attendance trends.")
Person(admin, "System Admin", "Configures RBAC, manages domain routing, and archives term records.")

System_Ext(entra_id, "Microsoft Entra ID", "External IAM service for managing RBAC and domain routing authorization.")
System_Ext(ai_engine, "AI Engine", "External service providing attendance summaries and trend analysis.")

' F.L.A.S.H. System Boundary
System_Boundary(flash_system, "F.L.A.S.H. System") {

    Container(web_portal, "Web Portal", "React / Node.js", "Provides UI for faculty class management, director dashboard/reports, and admin console.")
    Container(mobile_app, "Student Mobile App", "Kotlin / Swift", "Provides UI for student attendance logging and viewing personal attendance records.")
    
    Container(api_gateway, "API Gateway", "Nginx / Kong", "Routes client requests, handles domain routing, and validates identity tokens.")
    
    Container(attendance_service, "Attendance Core Service", "Python / Node.js", "Handles active class attendance management and attendance viewing.")
    Container(reporting_service, "Reporting & Analytics Service", "Python / Go", "Processes report generation, attendance trend analysis, and term archival jobs.")
    
    ContainerDb(unified_db, "Centralized Database System", "PostgreSQL / MySQL", "Stores active operational data (users, attendance logs, classes) and archived historical term records.")
}

' Admin Authentication Flow
Rel_L(admin, entra_id, "Manages RBAC & Domain Routing", "HTTPS")
Rel_L(web_portal, entra_id, "Delegates RBAC & Domain Routing check", "OAuth2 / OIDC")

' User Interactions -> Frontends
Rel_D(student, mobile_app, "Logs & views class attendance via", "HTTPS")
Rel_D(faculty, web_portal, "Manages class attendance & views reports via", "HTTPS")
Rel_D(director, web_portal, "Views class attendance, reports & trends via", "HTTPS")
Rel_D(admin, web_portal, "Configures RBAC & archives records via", "HTTPS")

' Frontends -> API Gateway
Rel_D(web_portal, api_gateway, "Sends API requests", "JSON / HTTPS")
Rel_D(mobile_app, api_gateway, "Sends attendance payloads", "JSON / HTTPS")

' API Gateway -> Internal Microservices
Rel_D(api_gateway, attendance_service, "Routes attendance management & view requests", "gRPC / HTTPS")
Rel_D(api_gateway, reporting_service, "Routes report management & trend requests", "gRPC / HTTPS")

' Reporting Service -> External AI Engine
Rel_R(reporting_service, ai_engine, "Sends trend data for summary generation", "JSON / HTTPS")

' Core Services -> Centralized Database
Rel_D(attendance_service, unified_db, "Reads/Writes active attendance records", "SQL")
Rel_D(reporting_service, unified_db, "Reads data for reports, trends & executes archive operations", "SQL")

@endluml