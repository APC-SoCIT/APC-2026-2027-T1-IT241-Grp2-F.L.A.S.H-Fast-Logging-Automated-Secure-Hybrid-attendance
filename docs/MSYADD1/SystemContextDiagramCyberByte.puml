@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context Diagram for F.L.A.S.H. (Fast Logging Automated Secure Hybrid Attendance System)

' Persons (Users)
Person(student, "SHS Student", "Logs attendance and views class attendance records.")
Person(faculty, "SHS Faculty", "Manages class attendance and manages attendance reports.")
Person(director, "SHS Director", "Manages attendance reports and views attendance trends.")
Person(admin, "System Admin", "Manages RBAC & domain routing and archives term records & logs.")

' Main System
System(flash, "F.L.A.S.H. System", "Automates class attendance management, report handling, summary generation, trend analytics, and term record archiving.")

' External Systems
System_Ext(ai_engine, "AI Engine", "Processes attendance data to manage attendance trends.")
System_Ext(entra, "Microsoft Entra ID", "Handles authentication for RBAC & domain routing.")

' Relationships - Users to System
Rel(student, flash, "Interacts with Manage Class Attendance", "HTTPS / Mobile / Web")
Rel(faculty, flash, "Manages class attendance & attendance reports", "HTTPS / Web")
Rel(director, flash, "Manages attendance reports & views attendance trends", "HTTPS / Web")
Rel(admin, flash, "Manages RBAC & domain routing, archives term records", "HTTPS / Web")

' Relationships - System to External Systems
Rel(flash, ai_engine, "Integrates with Manage Attendance Trends", "REST API / HTTPS")
Rel(flash, entra, "Integrates with Manage RBAC & Domain Routing", "OAuth 2.0 / OpenID Connect")

@enduml