@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context Diagram for F.L.A.S.H. (Fast Logging Automated Secure Hybrid Attendance System)

' Persons (Users)
Person(student, "SHS Student", "Views personal attendance, verifies geolocation, and scans ID or QR code.")
Person(faculty, "SHS Faculty", "Manages class attendance, requests summaries, analyzes trends, and downloads PDF reports.")
Person(director, "SHS Director", "Monitors school-wide attendance via centralized dashboard and views downloaded PDF reports.")
Person(admin, "System Admin", "Manages RBAC & domain routing and archives term records & logs.")

' Main System
System(flash, "F.L.A.S.H. System", "Automates attendance logging, geolocation verification, summary generation, analytics, and record archiving.")

' External Systems
System_Ext(ai_engine, "AI Engine", "Generates attendance summaries and analyzes attendance trends.")
System_Ext(entra, "Microsoft Entra ID", "Provides authentication and handles Role-Based Access Control (RBAC) & domain routing integration.")

' Relationships - Users to System
Rel(student, flash, "Scans ID/QR, verifies geolocation, and views personal attendance", "HTTPS / Mobile / Web")
Rel(faculty, flash, "Manages class attendance and triggers reports/summaries/analytics", "HTTPS / Web")
Rel(director, flash, "Views centralized dashboard and downloads PDF reports", "HTTPS / Web")
Rel(admin, flash, "Configures RBAC/routing and manages term archives & logs", "HTTPS / Web")

' Relationships - System to External Systems
Rel(flash, ai_engine, "Requests AI-generated summaries and trend analytics", "REST API / HTTPS")
Rel(flash, entra, "Authenticates users, manages RBAC, and enforces domain routing", "OAuth 2.0 / OpenID Connect")

@enduml